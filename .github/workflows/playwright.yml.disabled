name: Playwright E2E

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# PR #35 — pipeline E2E completo. Repos são split (frontend e backend
# vivem em GitHub separados), então este workflow:
#   1. Faz checkout do frontend (auto).
#   2. Faz checkout do backend em ./backend via actions/checkout@v4.
#   3. Sobe Postgres ephemeral, seeda, sobe backend + frontend preview,
#      roda Playwright.
#
# Token de checkout do backend:
#   - Repo backend PÚBLICO  → GITHUB_TOKEN basta (passar não é obrigatório).
#   - Repo backend PRIVADO  → criar PAT com escopo `repo` e salvar em
#     secrets.BACKEND_REPO_TOKEN (settings → secrets → actions).

jobs:
  e2e:
    name: Playwright (chromium + mobile-chromium)
    runs-on: ubuntu-latest
    timeout-minutes: 25

    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: apex
          POSTGRES_PASSWORD: apex
          POSTGRES_DB: apex_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10

    env:
      # Backend env
      NODE_ENV: test
      DATABASE_URL: postgresql://apex:apex@localhost:5432/apex_test?schema=public
      DIRECT_URL: postgresql://apex:apex@localhost:5432/apex_test?schema=public
      JWT_SECRET: ci-e2e-secret-must-be-at-least-32-characters-long-xx
      JWT_EXPIRES_IN: 7d
      CORS_ORIGIN: http://localhost:4173
      FRONTEND_URL: http://localhost:4173
      PORT: '3000'
      PUSH_ENABLED: 'false'
      ADMIN_SEED_EMAIL: admin-god@apex.com
      ADMIN_SEED_SENHA: changeme-god-mode
      # Frontend env
      VITE_API_URL: http://localhost:3000/api
      # Playwright runtime
      E2E_BACKEND_URL: http://localhost:3000
      E2E_FRONTEND_URL: http://localhost:4173
      E2E_ADMIN_EMAIL: admin-god@apex.com
      E2E_ADMIN_SENHA: changeme-god-mode
      E2E_NO_WEB_SERVER: '1'
      CI: 'true'

    steps:
      - name: Checkout frontend
        uses: actions/checkout@v4

      - name: Checkout backend (repo separado)
        uses: actions/checkout@v4
        with:
          repository: GiovaneXavier/apex-training-backend
          path: backend
          # Match a branch do PR sempre que possível; fallback main.
          ref: ${{ github.head_ref || github.ref_name }}
          token: ${{ secrets.BACKEND_REPO_TOKEN || secrets.GITHUB_TOKEN }}

      - name: Checkout backend (fallback main se ref não existir)
        if: failure()
        uses: actions/checkout@v4
        with:
          repository: GiovaneXavier/apex-training-backend
          path: backend
          ref: main
          token: ${{ secrets.BACKEND_REPO_TOKEN || secrets.GITHUB_TOKEN }}

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: |
            backend/package-lock.json
            package-lock.json

      # ─── Backend ────────────────────────────────────────────────────────
      - name: Install backend deps
        working-directory: backend
        run: npm ci

      - name: Prisma generate + migrate
        working-directory: backend
        run: |
          npx prisma generate
          npx prisma migrate deploy

      - name: Seed banco (users + dados)
        working-directory: backend
        run: npm run db:seed

      - name: Seed admin god-mode
        working-directory: backend
        run: npm run seed:admin
        continue-on-error: true

      - name: Start backend (background)
        working-directory: backend
        run: |
          npm run start > backend.log 2>&1 &
          echo $! > backend.pid
          for i in $(seq 1 30); do
            if curl -sf http://localhost:3000/api/health > /dev/null 2>&1 \
               || curl -sf http://localhost:3000/health > /dev/null 2>&1 \
               || curl -sf http://localhost:3000/ > /dev/null 2>&1; then
              echo "Backend up"
              exit 0
            fi
            sleep 1
          done
          echo "Backend não subiu em 30s"
          cat backend.log
          exit 1

      # ─── Frontend ───────────────────────────────────────────────────────
      - name: Install frontend deps
        run: npm ci

      - name: Cache Playwright browsers
        uses: actions/cache@v4
        id: playwright-cache
        with:
          path: ~/.cache/ms-playwright
          key: playwright-${{ runner.os }}-${{ hashFiles('package-lock.json') }}

      - name: Install Playwright browsers
        if: steps.playwright-cache.outputs.cache-hit != 'true'
        run: npx playwright install --with-deps chromium

      - name: Install Playwright system deps (cache hit)
        if: steps.playwright-cache.outputs.cache-hit == 'true'
        run: npx playwright install-deps chromium

      - name: Build frontend
        run: npm run build

      - name: Start frontend preview (background)
        run: |
          npm run preview -- --port 4173 --strictPort > frontend.log 2>&1 &
          echo $! > frontend.pid
          for i in $(seq 1 20); do
            if curl -sf http://localhost:4173 > /dev/null 2>&1; then
              echo "Frontend up"
              exit 0
            fi
            sleep 1
          done
          echo "Frontend não subiu em 20s"
          cat frontend.log
          exit 1

      # ─── Run Playwright ─────────────────────────────────────────────────
      - name: Run Playwright E2E
        run: npm run test:e2e

      # ─── Artifacts on failure ───────────────────────────────────────────
      - name: Upload Playwright report
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: tests-e2e/.report
          retention-days: 7

      - name: Upload Playwright traces
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-traces
          path: tests-e2e/.results
          retention-days: 7

      - name: Upload backend logs
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: backend-logs
          path: backend/backend.log
          retention-days: 3
